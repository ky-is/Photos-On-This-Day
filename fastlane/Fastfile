default_platform :ios

# sync_screenshots, the asset library and asc_request, shared by every app
require File.expand_path('~/Programming/fastlane-shared/app_store.rb')

PROJECT = 'Photos On This Day.xcodeproj'
SCHEME = 'Photos On This Day'
OUTPUT = File.expand_path('build', __dir__)

# Xcode's own products folder for the scheme, the one a normal build uses
def build_products_dir(configuration, destination)
	settings = sh('xcodebuild', '-project', "../#{PROJECT}", '-scheme', SCHEME, '-configuration', configuration, '-destination', destination, '-showBuildSettings', log: false)
	settings[/^\s*BUILD_DIR = (.+)$/, 1]
end
# Xcode 27's JSON project file, which agvtool can't edit
PROJECT_FILE = File.expand_path("../#{PROJECT}/project.xcproj", __dir__)
# The App Store Connect app (Apple ID)
APP_ID = '1620659723'
METADATA = File.expand_path('metadata', __dir__)
# The Mac version's text: the same, but desktop widgets, clicks and no Lock Screen, and no release notes (its first version)
METADATA_MAC = File.expand_path('metadata-mac', __dir__)
SCREENSHOTS = File.expand_path('screenshots', __dir__)

# The App Store Connect API key in fastlane/.env (shared with kanji-garden-ios), for build numbers and uploads
def api_key
	app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'), key_filepath: File.expand_path(ENV.fetch('ASC_KEY_PATH')))
end

# Automatic signing for the archive and the export, signed in to the developer account with the same API key, so Xcode needs no account
def signing_args
	['-allowProvisioningUpdates', '-authenticationKeyPath', File.expand_path(ENV.fetch('ASC_KEY_PATH')), '-authenticationKeyID', ENV.fetch('ASC_KEY_ID'), '-authenticationKeyIssuerID', ENV.fetch('ASC_ISSUER_ID')]
end

def versions
	text = File.read(PROJECT_FILE)
	{ version: text[/"MARKETING_VERSION": "([\d.]+)"/, 1], build: text[/"CURRENT_PROJECT_VERSION": "(\d+)"/, 1].to_i }
end

# The next build number: the project's, unless App Store Connect already has it (or higher) for this version
def bump_build(key)
	current = versions
	uploaded = latest_testflight_build_number(api_key: key, app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier), version: current[:version], platform: 'ios', initial_build_number: 0).to_i
	build = [current[:build], uploaded + 1].max
	# Every target's CURRENT_PROJECT_VERSION, so the widget extension keeps the app's build number
	File.write(PROJECT_FILE, File.read(PROJECT_FILE).gsub(/"CURRENT_PROJECT_VERSION": "\d+"/, %("CURRENT_PROJECT_VERSION": "#{build}")))
	UI.success("Version #{current[:version]} (#{build})")
end

# Bumps the build number in the project file (left for you to commit) and builds the App Store .ipa, or with mac: true the
# Mac .pkg (the same build number). Plain xcodebuild, since build_app (gym) reads project.pbxproj, which the JSON project
# format doesn't have.
def build_package(key, mac: false)
	bump_build(key) unless mac
	output = mac ? File.join(OUTPUT, 'mac') : OUTPUT
	archive = File.join(output, 'Photos On This Day.xcarchive')
	export = File.join(output, 'export')
	options = File.join(output, 'ExportOptions.plist')
	FileUtils.rm_rf([archive, export])
	FileUtils.mkdir_p(output)
	File.write(options, <<~PLIST)
		<?xml version="1.0" encoding="UTF-8"?>
		<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
		<plist version="1.0">
		<dict>
			<key>method</key><string>app-store-connect</string>
			<key>destination</key><string>export</string>
			<key>signingStyle</key><string>automatic</string>
			<key>teamID</key><string>#{CredentialsManager::AppfileConfig.try_fetch_value(:team_id)}</string>
			<key>manageAppVersionAndBuildNumber</key><false/>
			<key>uploadSymbols</key><true/>
		</dict>
		</plist>
	PLIST
	sh('xcodebuild', '-project', "../#{PROJECT}", '-scheme', SCHEME, '-configuration', 'Release', '-destination', mac ? 'generic/platform=macOS' : 'generic/platform=iOS', '-archivePath', archive, *signing_args, '-quiet', 'clean', 'archive')
	sh('xcodebuild', '-exportArchive', '-archivePath', archive, '-exportOptionsPlist', options, '-exportPath', export, *signing_args)
	FileUtils.rm_rf(archive)
	Dir[File.join(export, mac ? '*.pkg' : '*.ipa')].first || UI.user_error!("No package in #{export}")
end

# Each language's version text (description, keywords, what's new, promotional text, URLs) straight to the editable version,
# for when deliver can't run: it won't upload anything while the app info is locked
def upload_version_text(app, metadata, mac: false)
	fields = { 'description' => :description, 'keywords' => :keywords, 'release_notes' => :whatsNew, 'promotional_text' => :promotionalText, 'support_url' => :supportUrl, 'marketing_url' => :marketingUrl }
	version = app.get_edit_app_store_version(platform: mac ? Spaceship::ConnectAPI::Platform::MAC_OS : Spaceship::ConnectAPI::Platform::IOS) || UI.user_error!("No editable #{mac ? 'Mac' : 'iOS'} version on App Store Connect")
	version.get_app_store_version_localizations.each do |localization|
		folder = File.join(metadata, localization.locale)
		next UI.message("#{localization.locale}: no text here") unless File.directory?(folder)
		attributes = fields.filter_map { |file, key| path = File.join(folder, "#{file}.txt"); [key, File.read(path).strip] if File.exist?(path) }.to_h
		# A first version has no what's new
		attributes.delete(:whatsNew) if localization.whats_new.nil? && version.version_string == '1.0'
		localization.update(attributes: attributes)
		UI.message("#{localization.locale}: #{attributes.keys.join(', ')}")
	end
end

def release_notes_files
	Dir[File.join(METADATA, '*', 'release_notes.txt')].sort
end

def git(*args)
	require 'open3'
	out, status = Open3.capture2('git', *args)
	status.success? ? out : nil
end

# This version's release notes in every language, written by Claude Code from the commit messages since the last release
# (the newest 🔖 commit of an earlier version), in the style of that release's notes. A release under a month old keeps
# its main points, since many people won't have seen them yet.
def write_release_notes
	require 'json'
	require 'open3'
	version = versions[:version]
	sha, time, subject = git('log', '--format=%H %ct %s', '--grep=^🔖').lines.map { |line| line.chomp.split(' ', 3) }.find { |_, _, s| !s.start_with?("🔖 #{version} ") } || UI.user_error!('No 🔖 commit of an earlier version')
	previous = subject[/🔖 ([\d.]+)/, 1]
	days = ((Time.now.to_i - time.to_i) / 86_400.0).round
	commits = git('log', '--format=%s', '--invert-grep', '--grep=^🔖', "#{sha}..HEAD")
	locales = release_notes_files.map { |path| File.basename(File.dirname(path)) }
	old = locales.to_h { |locale| [locale, git('show', "#{sha}:fastlane/metadata/#{locale}/release_notes.txt") || ''] }
	prompt = <<~PROMPT
		Write the App Store release notes ("What's New") for version #{version} of Photos On This Day, an iPhone and iPad app that shows your photos taken on this day in past years, with widgets.

		These are the commit messages since #{previous} came out (gitmoji first: ✨ feature, 🐛 fix, 💄 look, ⚡️ speed, ♿️ accessibility, 🌐 languages):

		#{commits}
		Only include changes someone using the app would notice. Leave out the website, build scripts, fastlane and App Store work, screenshot tooling, refactors, and anything only on the Mac. Write each change plainly and briefly, the way the #{previous} notes below do, not the way the commits are worded.

		#{previous} came out #{days} days ago. #{days < 31 ? "Since that's recent, many people haven't seen it yet: after this version's changes, keep the important points of the #{previous} notes (its features and notable improvements; drop its minor fixes), shortened if needed, under a short heading like \"New in #{previous}:\"." : "Only describe what's new in #{version}."}

		Match the #{previous} notes' format: a first line like their "What's new in" line but for #{version}, then one "• " bullet per change. Keep each language under 4000 characters.

		The #{previous} notes, in each language (reuse their wording and terms where it fits):

		#{JSON.pretty_generate(old)}

		Reply with only a JSON object mapping each of these locales to its notes, nothing else: #{locales.join(', ')}
	PROMPT
	UI.message("Writing the #{version} release notes in #{locales.size} languages with Claude Code, from #{commits.lines.size} commits since #{previous}")
	out, error, status = Open3.capture3('claude', '-p', '--tools', '', '--no-session-persistence', stdin_data: prompt)
	UI.user_error!("claude -p failed: #{[out, error].join.strip}") unless status.success?
	notes = JSON.parse(out[/\{.*\}/m] || UI.user_error!("No JSON in Claude's reply:\n#{out}"))
	locales.each do |locale|
		text = notes[locale]&.strip || UI.user_error!("No #{locale} notes in Claude's reply")
		UI.user_error!("The #{locale} notes are over 4000 characters") if text.length > 4000
		File.write(File.join(METADATA, locale, 'release_notes.txt'), "#{text}\n")
	end
	UI.success("Release notes for #{version}:\n\n#{notes['en-US']}")
end

platform :ios do
	desc 'Run the unit tests on the simulator'
	lane :test do
		run_tests(project: PROJECT, scheme: SCHEME, output_directory: File.join(OUTPUT, 'tests'))
	end

	desc 'Build Release and install on the iPhone (DEVICE in .env, or the first paired iPhone)'
	lane :device do
		device = ENV['DEVICE'] || connected_iphone
		sh('xcodebuild', '-project', "../#{PROJECT}", '-scheme', SCHEME, '-configuration', 'Release', '-destination', 'generic/platform=iOS', *signing_args, '-quiet', 'build')
		sh('xcrun', 'devicectl', 'device', 'install', 'app', '--device', device, File.join(build_products_dir('Release', 'generic/platform=iOS'), 'Release-iphoneos/Photos On This Day.app'))
	end

	desc 'Screenshots for the required App Store sizes (iPhone 6.3", iPad 13") into fastlane/screenshots'
	lane :screenshots do
		sh('../bin/app-store-screenshots.zsh')
	end

	desc 'The App Store creative assets into fastlane/creative: the product page header, and the search results image in every language (bin/creative-assets.swift, from the screenshots and their photos)'
	lane :creative_assets do
		sh('xcrun', 'swift', '../bin/creative-assets.swift', File.expand_path('~/Documents/Programming/ky.is/ky.is/site/public/photos'), File.join(SCREENSHOTS, 'raw'), File.expand_path('creative', __dir__))
	end

	desc "Draw the creative assets (`creative_assets`), upload them to the app's asset library and place them on the editable iOS version: the header for every language, and each language's search results image. Doesn't submit"
	lane :upload_creative_assets do
		creative_assets
		creative = File.expand_path('creative', __dir__)
		key = api_key
		app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)) || UI.user_error!('App not found on App Store Connect')
		version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS) || UI.user_error!('No editable iOS version to place the assets on (one in review is locked)')
		# The header has no words, so every language shares one upload
		header = upload_creative_asset(key, app, File.join(creative, 'header.png'), 'photos-on-this-day-header.png')
		version.get_app_store_version_localizations.each do |localization|
			place_creative_asset(key, :image, header, 'PRODUCT_PAGE_HEADER_ASSET', localization)
			file = File.join(creative, localization.locale, 'search-results.png')
			next UI.important("No search results image for #{localization.locale}") unless File.exist?(file)
			place_creative_asset(key, :image, upload_creative_asset(key, app, file, "photos-on-this-day-search-#{localization.locale}.png"), 'APP_STORE_SEARCH_RESULTS_ASSET', localization)
			UI.success("Placed the header and search results image for #{localization.locale}")
		end
	end

	desc 'Upload the screenshots that changed to the editable version on App Store Connect (dry_run:true only reports)'
	lane :upload_screenshots do |options|
		sync_screenshots(api_key, folder: SCREENSHOTS, platform: options[:mac].to_s == 'true' ? 'osx' : 'ios', dry_run: options[:dry_run].to_s == 'true')
	end

	desc 'Upload fastlane/metadata and the screenshots, attach the latest build of this version, and submit it for review (uploads:false skips the uploads, review:false stops after them; mac:true does the Mac version, with fastlane/metadata-mac)'
	lane :submit do |options|
		uploads = options[:uploads].to_s != 'false'
		mac = options[:mac].to_s == 'true'
		platform = mac ? 'osx' : 'ios'
		key = api_key
		if uploads
			# The text first, since a new language's screenshots need its text on the version
			metadata = mac ? METADATA_MAC : METADATA
			# The name, subtitle, categories and privacy URL belong to the whole app, and can't change while any platform's
			# version is in review, and deliver then waits for them forever; so this sends only the version's own text, and
			# says what waits
			Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
			app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
			if app.fetch_edit_app_info
				upload_to_app_store(api_key: key, platform: platform, app_version: versions[:version], skip_binary_upload: true, skip_screenshots: true, metadata_path: metadata, submit_for_review: false, force: true, run_precheck_before_submit: false)
			else
				UI.important('The app info (name, subtitle, categories, privacy URL) is locked while a version is in review, so only the version text goes up now; send the rest with `fastlane submit review:false` once the review ends')
				upload_version_text(app, metadata, mac: mac)
			end
			sync_screenshots(key, folder: SCREENSHOTS, platform: mac ? 'osx' : 'ios')
		end
		next if options[:review].to_s == 'false'
		build = latest_testflight_build_number(api_key: key, app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier), version: versions[:version], platform: platform)
		# Released by hand once approved
		upload_to_app_store(api_key: key, platform: platform, app_version: versions[:version], build_number: build.to_s, skip_binary_upload: true, skip_metadata: true, skip_screenshots: true, submit_for_review: true, automatic_release: false, force: true, precheck_include_in_app_purchases: false, submission_information: { add_id_info_uses_idfa: false })
	end

	desc 'Build and upload to TestFlight (internal testers only; not submitted for external testing)'
	lane :beta do
		key = api_key
		upload_to_testflight(api_key: key, ipa: build_package(key), skip_waiting_for_build_processing: true)
	end

	desc 'Build and upload to App Store Connect (does not submit for review)'
	lane :release do
		key = api_key
		upload_to_app_store(api_key: key, ipa: build_package(key), app_version: versions[:version], skip_metadata: true, skip_screenshots: true, submit_for_review: false, precheck_include_in_app_purchases: false, force: true)
	end

	desc 'Start the next version once the current one is live on the App Store: bumps the version (minor if there are ✨ commits since the last 🔖 one, else patch; or bump: patch, minor or major) and the build number, builds and uploads it like `release`, writes the release notes (`release_notes`), and commits them with the bump as 🔖 (upload:false only bumps and writes the notes)'
	lane :next_version do |options|
		key = api_key
		Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
		app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
		live = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)&.version_string
		current = versions
		# Guards against bumping twice: the project's version must be the one on sale
		UI.user_error!("#{current[:version]} isn't live yet (the App Store has #{live || 'nothing'}); run `fastlane release` to upload a new build of it") unless live == current[:version]
		major, minor, patch = (current[:version].split('.').map(&:to_i) + [0, 0, 0]).first(3)
		# New features (a ✨ commit since the last 🔖 release commit) make it minor, otherwise patch
		released = sh('git', 'log', '-1', '--format=%H', '--grep=^🔖', log: false).strip
		features = sh('git', 'log', '--format=%s', *(released.empty? ? [] : ["#{released}..HEAD"]), log: false).lines.grep(/^✨/)
		bump = options[:bump] || (features.empty? ? 'patch' : 'minor')
		UI.message("#{features.size} new feature#{features.size == 1 ? '' : 's'} since the last release, so a #{bump} version") unless options[:bump]
		version = case bump.to_s
			when 'major' then "#{major + 1}.0"
			when 'minor' then "#{major}.#{minor + 1}"
			when 'patch' then "#{major}.#{minor}.#{patch + 1}"
			else UI.user_error!("bump: is patch, minor or major, not #{options[:bump]}")
		end
		# A new build number too, above every build uploaded so far
		uploaded = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: '-uploadedDate', limit: 10).first(10).map { |b| b.version.to_i }.max || 0
		build = [current[:build], uploaded].max + 1
		File.write(PROJECT_FILE, File.read(PROJECT_FILE).gsub(/"MARKETING_VERSION": "[\d.]+"/, %("MARKETING_VERSION": "#{version}")).gsub(/"CURRENT_PROJECT_VERSION": "\d+"/, %("CURRENT_PROJECT_VERSION": "#{build}")))
		UI.success("#{current[:version]} → #{version} (#{build})")
		write_release_notes
		next if options[:upload].to_s == 'false'
		release
		# The 🔖 commit marks the release, so the next run counts features from here
		git_commit(path: [PROJECT_FILE, *release_notes_files], message: "🔖 #{version} build #{versions[:build]}")
	end

	desc "Write this version's fastlane/metadata release notes in every language with Claude Code, from the app's commits since the last release (keeping that release's main points when it's under a month old)"
	lane :release_notes do
		write_release_notes
	end

	desc 'Build the Mac app and upload it to the Mac version on App Store Connect, with the build number of the last `release` (does not submit for review)'
	lane :release_mac do
		key = api_key
		upload_to_app_store(api_key: key, pkg: build_package(key, mac: true), platform: 'osx', app_version: versions[:version], skip_metadata: true, skip_screenshots: true, submit_for_review: false, precheck_include_in_app_purchases: false, force: true)
	end

	# First paired physical iPhone, as a UDID
	def connected_iphone
		require 'json'
		require 'tempfile'
		Tempfile.create(['devices', '.json']) do |f|
			sh('xcrun', 'devicectl', 'list', 'devices', '--quiet', '--json-output', f.path, log: false)
			phone = JSON.parse(File.read(f.path))['result']['devices'].find { |d| d.dig('hardwareProperties', 'deviceType') == 'iPhone' && d.dig('hardwareProperties', 'reality') == 'physical' && d.dig('connectionProperties', 'pairingState') == 'paired' }
			UI.user_error!('No paired iPhone found; set DEVICE in fastlane/.env') unless phone
			UI.message("Installing on #{phone.dig('deviceProperties', 'name')}")
			phone.dig('hardwareProperties', 'udid')
		end
	end
end
