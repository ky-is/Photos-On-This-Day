    "Note that photos you mark as **Hidden** from Photos.app are never displayed or even accessed by this app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die du in der Fotos-App als **Ausgeblendet** markierst, werden von dieser App nie angezeigt oder auch nur abgerufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que marques como **Ocultas** en la app Fotos nunca se muestran ni se leen en esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
